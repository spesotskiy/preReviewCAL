{
  "encoding": "utf-8-nobom",
  "lineEnding": "preserve",
  "fileNaming": {
    "template": "{prefix}{id} - {name}.txt",
    "typePrefixes": {
      "Table": "t",
      "Page": "p",
      "Report": "r",
      "Codeunit": "c",
      "XMLport": "x",
      "Query": "q",
      "MenuSuite": "m",
      "Form": "f",
      "Dataport": "d"
    }
  },
  "diff": {
    "maxOldFunctionLines": 50
  },
  "comments": {
    "codeMarkerPattern": "^\\s*//\\s*LCG\\s+[A-Za-z]{2,4}\\s+(?:[A-Za-z]+-?\\d+)\\s+\\d{2}\\.\\d{2}\\.\\d{4}(?:\\s*(?:<<|>>).*)?$",
    "commentedCodePattern": "(?i)(:=|;\\s*$|^(IF|THEN|ELSE|BEGIN|END|CASE|REPEAT|UNTIL|FOR|WHILE|WITH|EXIT)\\b|^[A-Za-z_][A-Za-z0-9_]*([ .][A-Za-z0-9_""]+)?\\s*\\(.*\\)\\s*;?$)",
    "keepCommentPrefix": "-"
  },
  "rules": {
    "CAL001": { "enabled": true },
    "CAL002": { "enabled": true },
    "CAL003": { "enabled": true },
    "CAL004": { "enabled": true },
    "CAL005": { "enabled": true },
    "CAL010": { "enabled": true, "suffix": "L" },
    "CAL011": { "enabled": true, "suffix": "P" },
    "CAL012": { "enabled": true },
    "CAL020": { "enabled": true },
    "CAL021": { "enabled": true },
    "CAL030": { "enabled": true, "indentSize": 2 },
    "CAL031": { "enabled": true },
    "CAL032": { "enabled": true },
    "CAL033": { "enabled": true },
    "CAL034": { "enabled": true },
    "CAL035": { "enabled": true }
  }
}
